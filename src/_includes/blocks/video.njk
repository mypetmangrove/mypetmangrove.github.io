{%- set vid = s.youtube | youtubeId %}
{% include "blocks/_open.njk" %}
  <div class="wrap split split--left">
    <div class="split__copy">
      {%- if s.heading %}<h2 class="h2">{{ s.heading }}</h2>{% endif %}
      {%- if s.body %}<div class="prose">{{ s.body | md | safe }}</div>{% endif %}
    </div>
    <figure class="video">
      <div class="video__frame" data-video="{{ vid }}">
        <img src="{{ s.poster or ('https://i.ytimg.com/vi/' + vid + '/hqdefault.jpg') }}" alt="" loading="lazy">
        <button class="video__play" type="button" aria-label="Play video: {{ s.caption or s.heading }}">
          <svg viewBox="0 0 64 64" width="64" height="64" aria-hidden="true"><circle cx="32" cy="32" r="31" fill="#143258" fill-opacity=".85"/><path d="M26 20v24l19-12z" fill="#fff"/></svg>
        </button>
      </div>
      {%- if s.caption %}<figcaption>{{ s.caption }} <a href="https://www.youtube.com/watch?v={{ vid }}">Watch on YouTube</a></figcaption>{% endif %}
    </figure>
  </div>
</section>
